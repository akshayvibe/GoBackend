# Environment Configuration
# Copy this file to .env and adjust values as needed

# Database
DB_PATH=./data/app.db

# Session
SESSION_TIMEOUT_MINUTES=30

# Account Lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Bcrypt
BCRYPT_COST=12

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
